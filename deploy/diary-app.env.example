# Template for /etc/diary-app/diary-app.env on the LXC (mode 0640, root:diary).
# Plain settings only. Secrets (the household PIN and session secret) are NOT
# stored here: create them with deploy/creds.sh (see docs/systemd-credentials.md).
# This file is committed to a public repo: never put real values in it.
LOG_LEVEL=INFO
# The iPad has no Web Inspector, so page errors show in a small banner.
# Set to false to hide it.
ERROR_BANNER=true
# SQLite database; /var/lib/diary-app is the service's StateDirectory.
DATABASE_PATH=/var/lib/diary-app/diary.db

# Outlook calendar (see docs/outlook-setup.md). Leave MS_CLIENT_ID blank until
# the app is registered; the calendar page then says it is not connected.
# Paste the "Application (client) ID" on the LXC only, never in this file.
MS_CLIENT_ID=
# The Outlook sign-in (private, 0600), kept in the service's state folder.
OUTLOOK_TOKEN_PATH=/var/lib/diary-app/outlook_token.json
# Event times are shown in this time zone.
TIMEZONE=Europe/London
