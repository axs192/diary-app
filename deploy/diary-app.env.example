# Template for /etc/diary-app/diary-app.env on the LXC (mode 0640, root:diary).
# Plain settings only. Secrets (API_KEY and later the PIN etc.) are NOT stored
# here: create them with deploy/creds.sh (see docs/systemd-credentials.md).
# This file is committed to a public repo: never put real values in it.
LOG_LEVEL=INFO
