# Copy to .env for local dev only (never commit .env), then run:
#   uv run --env-file .env uvicorn --factory diary_app.app:create_app
HOUSEHOLD_PIN=1234
SESSION_SECRET=dummy-session-secret-for-local-dev-only
DATABASE_PATH=data/diary.db
LOG_LEVEL=INFO
# Set to false to hide the on-screen JavaScript error banner.
ERROR_BANNER=true
